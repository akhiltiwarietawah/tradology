# ==============================================================================
# Tradology Trading Dashboard — Next.js Server Environment Configuration
# ==============================================================================
# SECURITY INVARIANT: All credentials in this file are SERVER-SIDE ONLY.
# They are never inlined into the client JavaScript bundle or sent to the browser.
# ==============================================================================

# Internal FastAPI Backend URL (Server-to-Server communication)
FASTAPI_BACKEND_URL=http://127.0.0.1:8000

# Private Server-Side API Authentication Key (Injected by Next.js proxy)
FASTAPI_API_KEY=your_secure_server_api_key_here

# Next.js Server Port
PORT=3000
