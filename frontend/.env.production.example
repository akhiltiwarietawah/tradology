# ==============================================================================
# Tradology Trading Dashboard — Next.js Server Environment Configuration
# ==============================================================================
# SECURITY INVARIANT: All credentials in this file are SERVER-SIDE ONLY.
# They are never inlined into the client JavaScript bundle or sent to the browser.
# ==============================================================================

# Internal FastAPI Backend URL (Server-to-Server communication)
FASTAPI_BACKEND_URL=http://127.0.0.1:8000

# Private Server-Side API Authentication Key (Injected by Next.js proxy)
FASTAPI_API_KEY=your_secure_server_api_key_here

# Next.js Server Port
PORT=3000

# ==============================================================================
# Google OAuth (NextAuth.js)
# ==============================================================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/api/auth/callback/google
# For local dev: http://localhost:3000/api/auth/callback/google

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_long_random_secret_here

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Comma-separated allowlist of Google account emails (required in production)
ALLOWED_GOOGLE_EMAILS=you@gmail.com

# Set to true only for local development without Google OAuth configured
# AUTH_DISABLED=true
