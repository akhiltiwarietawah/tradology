# ==============================================================================
# BTC 0DTE Long Straddle Strategy (1:00 PM IST - Mon to Fri)
# Delta Exchange India Options
# ==============================================================================

# Strategy Enable/Disable
BTC_0DTE_STRADDLE_ENABLED=true
BTC_0DTE_STRADDLE_ACCOUNT=straddle
BTC_0DTE_STRADDLE_UNDERLYING=BTC
BTC_0DTE_STRADDLE_CONTRACT_VALUE=0.001

# Entry & Settlement Times
BTC_0DTE_STRADDLE_ENTRY_TIME=13:00
BTC_0DTE_STRADDLE_ENTRY_WINDOW_MINUTES=15
BTC_0DTE_STRADDLE_EXIT_TIME=17:30
BTC_0DTE_STRADDLE_AUTO_SETTLEMENT=true

# Allowed Trading Days: 0=Mon, 1=Tue, 2=Wed, 3=Thu, 4=Fri (Sat & Sun excluded)
BTC_0DTE_STRADDLE_ALLOWED_WEEKDAYS=0,1,2,3,4

# ------------------------------------------------------------------------------
# Position Sizing Mode: "fixed" or "dynamic"
# ------------------------------------------------------------------------------
# Use "fixed" for fixed lots per entry, or "dynamic" to size from available equity.
BTC_0DTE_STRADDLE_POSITION_SIZING_MODE=fixed

# [Mode: fixed] Fixed lots per trade (1 lot = 0.001 BTC on Delta Exchange)
BTC_0DTE_STRADDLE_FIXED_LOTS=10

# [Mode: dynamic] Dynamic Sizing Parameters
BTC_0DTE_STRADDLE_SIZING_BASE_USD=50.0
BTC_0DTE_STRADDLE_MARGIN_PCT=0.25
BTC_0DTE_STRADDLE_PROFIT_RETAIN_PCT=0.5
BTC_0DTE_STRADDLE_MIN_LOTS=1
BTC_0DTE_STRADDLE_MAX_LOTS=500

# Optional dedicated API keys for this strategy (leave empty to reuse DELTA_LIVE_* or DELTA_TESTNET_*)
BTC_0DTE_STRADDLE_API_KEY=
BTC_0DTE_STRADDLE_API_SECRET=
