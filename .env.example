# ==========================================
# Delta Exchange India & Trading Engine Config
# ==========================================

# Environment Selector: 'testnet' or 'live' (DEFAULT: testnet)
# Changing this single variable switches the active endpoints and credentials.
DELTA_ENV=testnet

# Testnet Credentials & Endpoints
DELTA_TESTNET_API_KEY=your_testnet_api_key_here
DELTA_TESTNET_API_SECRET=your_testnet_api_secret_here
DELTA_TESTNET_REST_URL=https://cdn-ind.testnet.deltaex.org
DELTA_TESTNET_WS_URL=wss://socket-ind.testnet.deltaex.org

# Live Credentials & Endpoints (Leave empty until deploying live)
DELTA_LIVE_API_KEY=
DELTA_LIVE_API_SECRET=
DELTA_LIVE_REST_URL=https://api.india.delta.exchange
DELTA_LIVE_WS_URL=wss://socket.india.delta.exchange

# ==========================================
# Strategy Parameters (0DTE Short Strangle)
# ==========================================
STRATEGY=short_strangle
UNDERLYING=BTC
ENTRY_TIME_IST=09:00:00
ENTRY_WINDOW_MINUTES=15
EXIT_TIME_IST=17:15:00

# Target premium per leg in USD (CE ≈ $100, PE ≈ $100)
TARGET_PREMIUM=100.0
# Acceptable tolerance around target premium (e.g. 30.0 -> $70-$130)
PREMIUM_TOLERANCE_USD=30.0

# Sizing: Number of contracts (1 contract = 0.001 BTC on Delta India = min order size)
ORDER_QUANTITY=1

# Stop Loss (1.0 = 100% loss / 2x entry price)
SL_PERCENTAGE=1.0

# ==========================================
# Execution & Emergency Safety
# ==========================================
# Two-leg entry timeout: max seconds to confirm 2nd leg entry before emergency unwind
TWO_LEG_ENTRY_TIMEOUT_SECONDS=10.0
# Policy when 1 leg fills and 2nd leg fails: 'UNWIND_FILLED_LEG'
TWO_LEG_EMERGENCY_POLICY=UNWIND_FILLED_LEG

# Maximum daily loss limit as multiple/percentage of initial entry premium (2.1 = 210%). If breached, square off and halt.
MAX_DAILY_LOSS_PCT=2.1

# Fallback maximum daily loss limit across both legs (USD).
MAX_DAILY_LOSS_USD=500.0

# Emergency Kill Switch (true = halt engine immediately and block new orders)
KILL_SWITCH=false

# Dry-run mode (simulates orders without hitting exchange trading endpoints)
DRY_RUN=false

# ==========================================
# Server & Logging
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
DATA_DIR=data
STATE_FILE=data/trade_state.json
LOGS_DIR=logs
WS_RECONNECT_MAX_ATTEMPTS=10
WS_RECONNECT_BASE_DELAY_SECONDS=2.0
REST_REQUEST_TIMEOUT_SECONDS=10.0
RECONCILIATION_INTERVAL_SECONDS=30.0

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# ==========================================
# Monitoring & Alert Configuration
# ==========================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=300


