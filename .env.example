# ==========================================
# Delta Exchange India & Trading Engine Config
# ==========================================
# Copy to .env and fill in your credentials.
# Working .env backups: scratch/backups/.env.backup.*

# Environment Selector: 'testnet' or 'live'
DELTA_ENV=testnet

# Testnet Credentials & Endpoints
DELTA_TESTNET_API_KEY=your_testnet_api_key_here
DELTA_TESTNET_API_SECRET=your_testnet_api_secret_here
DELTA_TESTNET_REST_URL=https://cdn-ind.testnet.deltaex.org
DELTA_TESTNET_WS_URL=wss://socket-ind.testnet.deltaex.org

# Live Credentials & Endpoints
DELTA_LIVE_API_KEY=your_live_api_key_here
DELTA_LIVE_API_SECRET=your_live_api_secret_here
DELTA_LIVE_REST_URL=https://api.india.delta.exchange
DELTA_LIVE_WS_URL=wss://socket.india.delta.exchange

# ==========================================
# Strategy Parameters (0DTE Short Strangle)
# ==========================================
STRATEGY=short_strangle
UNDERLYING=BTC
ENTRY_TIME_IST=09:00:00
ENTRY_WINDOW_MINUTES=15
EXIT_TIME_IST=17:15:00

TARGET_PREMIUM=100.0
PREMIUM_TOLERANCE_USD=30.0
# Sizing: Number of contracts (1 contract = 0.001 BTC on Delta India = min order size)
ORDER_QUANTITY=50
SL_PERCENTAGE=1.0
TARGET_PRICE=5.0

TWO_LEG_ENTRY_TIMEOUT_SECONDS=10.0
TWO_LEG_EMERGENCY_POLICY=UNWIND_FILLED_LEG

MAX_DAILY_LOSS_PCT=2.1
MAX_DAILY_LOSS_USD=500.0

KILL_SWITCH=false
DRY_RUN=false

# ==========================================
# Server & Logging
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
DATA_DIR=data
STATE_FILE=data/trade_state.json
LOGS_DIR=logs
WS_RECONNECT_MAX_ATTEMPTS=10
WS_RECONNECT_BASE_DELAY_SECONDS=2.0
REST_REQUEST_TIMEOUT_SECONDS=10.0
RECONCILIATION_INTERVAL_SECONDS=30.0

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=5.0
DB_ENABLED=true

# ==========================================
# Monitoring & Alert Configuration
# Halt / SAFE_HALT / kill-switch / missing SL send Telegram when enabled.
# BotFather -> token; send a msg to the bot; get chat_id from getUpdates.
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=300

# ==========================================
# Renko + Ichimoku (ETH, SOL, XRP — separate strategies)
# Platform codes: renko_ichimoku_eth | renko_ichimoku_sol | renko_ichimoku_xrp
# See docs/RENKO_ICHIMOKU.md
#
# Run ETH only:  STRATEGY_ENABLED=true,  SOL_ENABLED=false
# Run SOL only:  STRATEGY_ENABLED=false, SOL_ENABLED=true
# Run both:      both true (separate state, positions, dashboard tabs)
# ==========================================
# Short strangle (BTC 0DTE). Set false to run Renko ETH+SOL only.
EXISTING_STRATEGY_ENABLED=false
EXISTING_STRATEGY_ACCOUNT=strangle
# Optional separate Delta keys for the strangle account (used when EXISTING_STRATEGY_ENABLED=true).
EXISTING_STRATEGY_API_KEY=
EXISTING_STRATEGY_API_SECRET=

# Renko ETH+SOL share this account label. Uses DELTA_LIVE_* when RENKO_ICHIMOKU_API_* are empty.
RENKO_ICHIMOKU_ACCOUNT=renko
# Required only when BOTH strangle and Renko run on different accounts simultaneously:
RENKO_ICHIMOKU_API_KEY=
RENKO_ICHIMOKU_API_SECRET=
RENKO_ICHIMOKU_CANDLE_RESOLUTION=15m

# --- Renko ETH (strategy: renko_ichimoku_eth) ---
RENKO_ICHIMOKU_STRATEGY_ENABLED=true
RENKO_ICHIMOKU_SYMBOL=ETHUSDT
RENKO_ICHIMOKU_BOX_SIZE=15
# Contracts per trade. NOT ORDER_QUANTITY. 0 = signals only, no orders.
RENKO_ICHIMOKU_POSITION_SIZE=0
# Position sizing: fixed (contracts above) or dynamic (% equity, virtual 50% withdraw on wins)
RENKO_ICHIMOKU_POSITION_SIZING_MODE=dynamic
RENKO_ICHIMOKU_SIZING_BASE_USD=50
RENKO_ICHIMOKU_MARGIN_PCT=0.25
RENKO_ICHIMOKU_LEVERAGE=10
RENKO_ICHIMOKU_PROFIT_RETAIN_PCT=0.5
# Default: data/renko_ichimoku_eth_state_{testnet|live}.json
# RENKO_ICHIMOKU_STATE_FILE=data/renko_ichimoku_eth_state_testnet.json
RENKO_ICHIMOKU_FLATTEN=false

# --- Renko SOL (strategy: renko_ichimoku_sol) ---
RENKO_ICHIMOKU_SOL_ENABLED=true
RENKO_ICHIMOKU_SOL_SYMBOL=SOLUSDT
RENKO_ICHIMOKU_SOL_BOX_SIZE=0.42
RENKO_ICHIMOKU_SOL_POSITION_SIZE=0
# Default: data/renko_ichimoku_sol_state_{testnet|live}.json
# RENKO_ICHIMOKU_SOL_STATE_FILE=data/renko_ichimoku_sol_state_testnet.json
RENKO_ICHIMOKU_SOL_FLATTEN=false

# --- Renko XRP (strategy: renko_ichimoku_xrp) ---
RENKO_ICHIMOKU_XRP_ENABLED=false
RENKO_ICHIMOKU_XRP_SYMBOL=XRPUSDT
RENKO_ICHIMOKU_XRP_BOX_SIZE=0.003
RENKO_ICHIMOKU_XRP_POSITION_SIZE=0
# Default: data/renko_ichimoku_xrp_state_{testnet|live}.json
# RENKO_ICHIMOKU_XRP_STATE_FILE=data/renko_ichimoku_xrp_state_testnet.json
RENKO_ICHIMOKU_XRP_FLATTEN=false

# --- Rollout groups — see docs/RENKO_ASSET_GROUPS.md ---
# Group A alts (8) + ETH/SOL/XRP = primary 11
RENKO_ICHIMOKU_ALTS_ENABLED=
# Group B: sui,inj,near,apt,pepe,wif,ena,jup
RENKO_ICHIMOKU_ALTS_GROUP_B_ENABLED=
# Group C: ton,dot,atom,ltc,bch,uni,aave,pol,sei,tia,op,arb,paxg
RENKO_ICHIMOKU_ALTS_GROUP_C_ENABLED=
# ZEC — separate from A/B/C (backtest watchlist)
RENKO_ICHIMOKU_ZEC_ENABLED=false
# Per coin: RENKO_ICHIMOKU_BTC_BOX_SIZE, _SIZING_BASE_USD, _API_KEY, ...
# One Delta wallet: ≤4 Renko coins recommended (engine warns above 4).
# Example 4-coin book on one $700 wallet (virtual $50 each):
# RENKO_ICHIMOKU_STRATEGY_ENABLED=true
# RENKO_ICHIMOKU_SOL_ENABLED=true
# RENKO_ICHIMOKU_XRP_ENABLED=true
# RENKO_ICHIMOKU_ALTS_ENABLED=btc
# All alts at once (separate wallets or accept margin overlap):
# RENKO_ICHIMOKU_ALTS_ENABLED=btc,bnb,doge,ada,trx,avax,link,hype
# Only if many coins share ONE wallet (not needed when each coin has its own API keys)
RENKO_ICHIMOKU_SPLIT_MARGIN_ACROSS_BOOK=false

# Per-coin Delta account (optional — each coin = separate virtual book + separate wallet):
# RENKO_ICHIMOKU_ETH_ACCOUNT=renko_eth
# RENKO_ICHIMOKU_ETH_API_KEY=
# RENKO_ICHIMOKU_ETH_API_SECRET=
# RENKO_ICHIMOKU_SOL_API_KEY= ...
# RENKO_ICHIMOKU_XRP_API_KEY= ...
# RENKO_ICHIMOKU_BTC_API_KEY= ...   (same pattern for registry alts)

# RENKO_ICHIMOKU_ALTS_ENABLED=btc,bnb,link

# ==========================================
# Platform Runtime (keep FALSE until verified)
# ==========================================
CREDENTIALS_ENCRYPTION_KEY=
PLATFORM_SYNC_INTERVAL_SECONDS=60
PLATFORM_RUNTIME_EXECUTION_ENABLED=false
PLATFORM_DELTA_LIVE_ENABLED=false
PLATFORM_LIVE_TRADING_ENABLED=false
PLATFORM_LIVE_DRY_RUN_ENABLED=true
PLATFORM_RUNTIME_HEARTBEAT_SECONDS=15
PLATFORM_RUNTIME_WORKER_ID=api-worker-1
PLATFORM_MAX_LIVE_TEST_QUANTITY=1
PLATFORM_MAX_LIVE_TEST_NOTIONAL=500
