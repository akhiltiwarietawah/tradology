# ==============================================================================
# Tradology BTC Options Algorithmic Trading Engine — Production Environment Config
# ==============================================================================
# SAFETY INVARIANT: By default, KILL_SWITCH=true and DRY_RUN=true.
# Live trading requires explicit, conscious disarming after startup verification.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Exchange Credentials (Delta Exchange India)
# ------------------------------------------------------------------------------
# Options: 'testnet' or 'live'
DELTA_ENV=testnet

# Testnet Credentials & URLs (Active when DELTA_ENV=testnet)
DELTA_TESTNET_API_KEY=your_testnet_api_key_here
DELTA_TESTNET_API_SECRET=your_testnet_api_secret_here
DELTA_TESTNET_REST_URL=https://cdn-ind.testnet.deltaex.org
DELTA_TESTNET_WS_URL=wss://socket-ind.testnet.deltaex.org

# Production Live Credentials & URLs (Active when DELTA_ENV=live)
DELTA_LIVE_API_KEY=your_live_api_key_here
DELTA_LIVE_API_SECRET=your_live_api_secret_here
DELTA_LIVE_REST_URL=https://api.india.delta.exchange
DELTA_LIVE_WS_URL=wss://socket.india.delta.exchange

# ------------------------------------------------------------------------------
# 2. Strategy & Sizing Parameters (0DTE Short Strangle)
# ------------------------------------------------------------------------------
STRATEGY=short_strangle
UNDERLYING=BTC
ENTRY_TIME_IST=09:00:00
ENTRY_WINDOW_MINUTES=15
EXIT_TIME_IST=17:15:00

# Target premium per leg in USD (CE ≈ $100, PE ≈ $100)
TARGET_PREMIUM=100.0
# Acceptable search tolerance around target premium (e.g. ±$30 -> $70 to $130)
PREMIUM_TOLERANCE_USD=30.0

# Order sizing in contracts (1 contract = 0.001 BTC on Delta India)
ORDER_QUANTITY=1

# Stop loss percentage (1.0 = 100% loss / 2x entry price)
SL_PERCENTAGE=1.0

# ------------------------------------------------------------------------------
# 3. Risk Controls & Emergency Safeguards
# ------------------------------------------------------------------------------
# Two-leg entry timeout: max seconds to confirm 2nd leg before emergency unwind
TWO_LEG_ENTRY_TIMEOUT_SECONDS=10.0
TWO_LEG_EMERGENCY_POLICY=UNWIND_FILLED_LEG

# Maximum daily realized + unrealized loss limit in USD. If breached, square-off and halt.
MAX_DAILY_LOSS_USD=500.0

# Emergency Kill Switch (true = blocks all order execution and new entries)
KILL_SWITCH=true

# Dry Run Simulation Mode (true = paper trading simulation without live orders)
DRY_RUN=true

# ------------------------------------------------------------------------------
# 4. Engine, Server & Persistence Configuration
# ------------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
LOG_LEVEL=INFO
DATA_DIR=data
STATE_FILE=data/trade_state.json
LOGS_DIR=logs

WS_RECONNECT_MAX_ATTEMPTS=10
WS_RECONNECT_BASE_DELAY_SECONDS=2.0
REST_REQUEST_TIMEOUT_SECONDS=10.0
RECONCILIATION_INTERVAL_SECONDS=30.0

# ------------------------------------------------------------------------------
# 5. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=crypto_trading
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=5.0
DB_ENABLED=true

# ------------------------------------------------------------------------------
# 6. Monitoring & Alert Notifications (Telegram)
# ------------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=300
